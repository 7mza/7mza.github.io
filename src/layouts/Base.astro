            aria-hidden="true">
            <span class="idle-shadow"></span>
            <img
              class="h-full w-auto max-w-none"
              alt=""
              decoding="async"
              height="687"
              loading="lazy"
              src="/7mza.webp"
              width="253"
            />
          </div>
        </div>
        <slot name="wide" />
      </article>

---
import '../main.css';
import { shortDate } from '../date.js';
const { title, description, ogType = 'profile' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isIndex = Astro.url.pathname === '/';
const now = new Date();
const timezone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', timeZoneName: 'short' })
  .formatToParts(now)
  .find((part) => part.type === 'timeZoneName')?.value;
---

<!-- this landing page is mostly satire, hit me through the alias for the "square" résumé, I can help u build solid things -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width, initial-scale=1"
      name="viewport"
    />
    <meta
      content="light dark"
      name="color-scheme"
    />
    <title>{title}</title>
    <meta
      content={description}
      name="description"
    />
    <meta
      content={isIndex ? 'max-image-preview:large' : 'noindex, nofollow'}
      name="robots"
    />
    <meta
      content={title}
      property="og:title"
    />
    <meta
      content={description}
      property="og:description"
    />
    <meta
      content={ogType}
      property="og:type"
    />
    <meta
      content={canonical}
      property="og:url"
    />
    <meta
      content="https://7mza.github.io/og.png"
      property="og:image"
    />
    <meta
      content="1200"
      property="og:image:width"
    />
    <meta
      content="1200"
      property="og:image:height"
    />
    <meta
      content="Hamza BAAZIZ - Backend Software Engineer - JVM &amp; Cloud Native"
      property="og:image:alt"
    />
    <link
      href={canonical}
      rel="canonical"
    />
    <link
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cstyle%3Etext{fill:%23000}@media(prefers-color-scheme:dark){text{fill:%23fff}}%3C/style%3E%3Ctext x='50' y='78' text-anchor='middle' font-size='92' font-family='system-ui,sans-serif' font-weight='900'%3E7%3C/text%3E%3C/svg%3E"
      rel="icon"
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <svg
      class="absolute size-0 overflow-hidden"
      aria-hidden="true">
      <symbol
        id="i-github"
        viewBox="0 0 24 24">

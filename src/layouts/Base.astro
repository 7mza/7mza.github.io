          aria-hidden="true">
          /
        </span>
        <span>
          build <time datetime={now.toISOString()}>{shortDate(now)}</time>
        </span>
        <span
          class="opacity-40"
          aria-hidden="true">
          /
        </span>
        <a
          class="link link-hover flex items-center gap-1.5"
          href="https://github.com/7mza/7mza.github.io"
          rel="noopener noreferrer"
          target="_blank">
          <svg
            class="size-4 fill-current"
            aria-hidden="true">
            <use href="#i-github" />
          </svg>
          src
        </a>
        <span
          class="opacity-40"
          aria-hidden="true">
          /
        </span>
        <button
          class="link link-hover flex items-center gap-1.5"
          id="linkedin-bait"
          type="button">

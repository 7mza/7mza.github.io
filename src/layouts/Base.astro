              </label>
            </div>
            <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm tracking-wide opacity-80 md:text-base md:tracking-normal">
              <span>Freelance, B2B</span>
              <span
                class="opacity-40"
                aria-hidden="true">
                /
              </span>
              <span>Remote, {timezone}</span>
              <span
                class="opacity-40"
                aria-hidden="true">
                /
              </span>
              <a
                class="link"
                href="mailto:7mza.venomous773@aleeas.com">
                Contact
              </a>
            </p>
          </div>
        </header>
        <div class="flex items-start gap-4 md:gap-6">
          <div class="min-w-0 grow">
            <slot />
            {!isIndex && (
              <p class="mt-8">
                <a
                  class="link link-hover flex w-fit items-center gap-1.5"
                  href="/">
                  <svg
                    class="size-4"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24">
                    <path
                      d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />

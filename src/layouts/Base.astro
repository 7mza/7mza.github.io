    </svg>
    <main class="mx-auto w-full max-w-5xl grow">
      <article class="px-4 py-6 md:px-6 md:py-8">
        <header class="flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-5">
          <button
            class="avatar shrink-0 cursor-zoom-in self-start transition-[scale,opacity] duration-100 active:scale-95 active:opacity-80 motion-reduce:active:scale-100 md:self-center"
            id="avatar"
            type="button">
            <div class="w-16 rounded-full md:w-20">
              <p
                class="mug"
                data-nosnippet>
                <span>blurry office wall</span>
                <span>crossed arms</span>
                <span>fluorescent smile</span>
                <span>&amp;</span>
                <span>radiating synergy!</span>
              </p>
            </div>
          </button>
          <div class="w-full min-w-0 grow">
            <div class="flex items-center justify-between gap-3">
              <h1 class="text-4xl leading-[1.05] font-black tracking-tight md:text-6xl md:tracking-tighter">
                <a href="/">Hamza BAAZIZ</a>
              </h1>
              <label
                class="swap swap-rotate shrink-0 p-2 transition-[scale,opacity] duration-100 active:scale-90 active:opacity-60 motion-reduce:active:scale-100"
                title="Toggle theme">
                <input
                  id="theme-toggle"
                  aria-label="Toggle dark theme"
                  type="checkbox"
                />
                <svg
                  class="swap-off size-7 fill-current"
                  viewBox="0 0 24 24">
                  <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
                </svg>
                <svg
                  class="swap-on size-7 fill-current"
                  viewBox="0 0 24 24">

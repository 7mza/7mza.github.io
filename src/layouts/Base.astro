      id="toaster"
      role="status"></div>
    <script>
      import '../main.js';
    </script>
    <script
      is:inline
      data-cf-beacon='{"token": "931a9041259747ada8020bd367e28fd9"}'
      src="https://static.cloudflareinsights.com/beacon.min.js"
      type="module"></script>
  </body>
</html>

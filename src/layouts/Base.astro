      id="zoom"
      aria-hidden="true">
      <div class="zoom-img">
        <p class="mug">
          <span>blurry office wall</span>
          <span>crossed arms</span>
          <span>fluorescent smile</span>
          <span>&amp;</span>
          <span>radiating synergy!</span>
        </p>
      </div>
    </div>
    <div

{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "npm run build && vite preview --host",
    "clean": "rm -rf dist && npm prune && npm cache verify",
    "format": "prettier \"**/*.{css,html,js,json,md,mjs,xml,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{css,html,js,json,md,mjs,xml,yml,yaml}\" --check",
    "lint": "eslint",
    "ncu": "ncu"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/roboto-serif": "^5.3.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.28",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "prettier": {
    "attributeSort": "ASC",
    "bracketSameLine": true,
    "plugins": [
      "@prettier/plugin-xml",
      "prettier-plugin-organize-attributes",
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "singleAttributePerLine": true
  }
}
